# Local development secrets (never use these in production)

# ES256 key pair in PEM format (PKCS#8 private, X.509 public).
# You can generate with:
#   openssl ecparam -name prime256v1 -genkey -noout -out ec-private.pem
#   openssl ec -in ec-private.pem -pubout -out ec-public.pem
# Then paste the contents (including BEGIN/END lines) below or export as env vars.
SECURITY_JWT_PRIVATE_KEY=""
SECURITY_JWT_PUBLIC_KEY=""

REFRESH_TOKEN_PEPPER="some-random-pepper-string-for-refresh-tokens"
PASSWORD_RESET_TOKEN_PEPPER="some-random-pepper-string-for-password-reset-tokens"
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@tickon.com"