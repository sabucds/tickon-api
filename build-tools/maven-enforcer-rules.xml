<?xml version="1.0" encoding="UTF-8"?>
<enforcer-rules>
    <!-- Custom rules to prevent microservice dependencies -->
    <bannedDependencies>
        <excludes>
            <!-- Prevent identity-service from importing other services -->
            <exclude>com.example:event-service</exclude>
            <exclude>com.example:api-gateway</exclude>
            
            <!-- Prevent event-service from importing other services -->
            <exclude>com.example:identity-service</exclude>
            <exclude>com.example:api-gateway</exclude>
            
            <!-- API Gateway can depend on nothing (uses HTTP/REST) -->
            <exclude>com.example:identity-service</exclude>
            <exclude>com.example:event-service</exclude>
        </excludes>
        <message>
            Microservices must not depend on each other directly!
            Use REST APIs or message queues for inter-service communication.
        </message>
    </bannedDependencies>
</enforcer-rules>