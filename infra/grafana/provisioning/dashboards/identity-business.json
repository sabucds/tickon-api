{
  "title": "Identity Service — Business Metrics",
  "uid": "identity-business",
  "schemaVersion": 38,
  "tags": ["identity-service"],
  "panels": [
    {
      "id": 1,
      "title": "Registrations per Minute",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(identity_user_registered_total[1m])",
          "legendFormat": "registrations/min"
        }
      ]
    },
    {
      "id": 2,
      "title": "Login Success vs Failure",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(identity_auth_login_attempt_total{outcome=\"success\"}[1m])",
          "legendFormat": "success"
        },
        {
          "expr": "rate(identity_auth_login_attempt_total{outcome=\"failure\"}[1m])",
          "legendFormat": "failure"
        }
      ]
    },
    {
      "id": 3,
      "title": "Login Failure Breakdown",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "increase(identity_auth_login_failure_total[1h])",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Token Refresh Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(identity_auth_token_refresh_total{outcome=\"success\"}[1m])",
          "legendFormat": "success"
        },
        {
          "expr": "rate(identity_auth_token_refresh_total{outcome=\"failure\"}[1m])",
          "legendFormat": "failure"
        }
      ]
    },
    {
      "id": 5,
      "title": "Password Reset Funnel",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "increase(identity_auth_password_reset_requested_total[1h])",
          "legendFormat": "requested"
        },
        {
          "expr": "increase(identity_auth_password_reset_completed_total[1h])",
          "legendFormat": "completed"
        },
        {
          "expr": "increase(identity_auth_password_reset_failed_total[1h])",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 6,
      "title": "Email Send Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(identity_email_sent_total{outcome=\"success\"}[1m])",
          "legendFormat": "success"
        },
        {
          "expr": "rate(identity_email_sent_total{outcome=\"failure\"}[1m])",
          "legendFormat": "failure"
        }
      ]
    }
  ]
}
